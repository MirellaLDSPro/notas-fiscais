# Copie para .env.local (dev) e configure no Vercel (prod).

# Postgres do Neon (https://neon.tech). Use a connection string "pooled" para serverless.
DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require

# Receitas geradas pela Claude API. Sem esta chave, /receitas mostra um placeholder.
ANTHROPIC_API_KEY=sk-ant-...
