# Copie para .env.local (dev) e configure no Vercel (prod).

# Postgres do Neon (https://neon.tech). Use a connection string "pooled" para serverless.
DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require

# Receitas geradas pela Claude API. Sem esta chave, /receitas mostra um placeholder.
ANTHROPIC_API_KEY=sk-ant-...

# Auth (NextAuth v5). Gere o secret com: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Lista de emails autorizados a entrar (separados por vírgula).
AUTH_ALLOWED_EMAILS=
